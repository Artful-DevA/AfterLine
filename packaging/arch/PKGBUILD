# Maintainer: Artful-DevA <246381290+Artful-DevA@users.noreply.github.com>
pkgname=afterline
pkgver=0.2.0
pkgrel=1
pkgdesc="Private, offline meeting recorder with transcripts and notes"
arch=('x86_64')
url="https://github.com/Artful-DevA/AfterLine"
license=('MIT')
depends=('qt6-base' 'qt6-svg' 'pipewire' 'opus' 'libogg' 'sqlite' 'gcc-libs' 'glibc' 'hicolor-icon-theme')
makedepends=('cmake' 'git')
checkdepends=('wireplumber')
optdepends=('wireplumber: PipeWire session manager (needed for audio devices)'
            'qt6-wayland: native Wayland window')
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  cmake -S "$pkgname" -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure -LE pipewire
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
